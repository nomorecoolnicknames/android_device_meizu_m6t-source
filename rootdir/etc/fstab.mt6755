# fstab.mt6755 - Meizu M6T (M6T / M811H), MT6750, LineageOS 20 / Android 13
#
# ###########################################################################
# NOTHING IN THIS FILE HAS BEEN VERIFIED ON HARDWARE. There is no M6T in this
# project (M6T_ROADMAP.md §1). The numbers below are derived from the factory
# scatter; the derivation is spelled out so the next person can check it in one
# adb command instead of trusting it.
# ###########################################################################
#
# WHY THE FILE IS CALLED fstab.mt6755 ON A "mt6750" PHONE
#   FACT: the stock M6T ramdisk ships fstab.mt6755 (M6T_DUMP_ANALYSIS_2026-07-22.md
#   §4), and init looks the fstab up by ro.hardware. MT6750 is the down-binned
#   MT6755 bin and the BSP is mt6755 (factbase §7). On the sibling M6 this is
#   measured: [ro.hardware]: [mt6755].
#
# BLOCK-DEVICE MAP - DERIVATION
#   FACT: /srv/forge/m6t-dump/scatter.txt lists the eMMC user-area partitions in
#   this order (preloader/pgpt are not user-area; flashinfo/sgpt are tail
#   markers):
#     1 recovery, 2 para, 3 custom, 4 expdb, 5 frp, 6 nvdata, 7 proinfo,
#     8 devinfo, 9 metadata, 10 protect1, 11 protect2, 12 seccfg,
#     13 oemkeystore, 14 md1img, 15 md1dsp, 16 md1arm7, 17 md3img, 18 nvram,
#     19 lk, 20 lk2, 21 boot, 22 logo, 23 tee1, 24 tee2, 25 secro,
#     26 keystore, 27 rstinfo, 28 system, 29 cache, 30 userdata
#   FACT: that name/order sequence is IDENTICAL to M6's scatter - diffing
#   /srv/forge/m6t-dump/scatter.txt against
#   /srv/forge/android/meizu_m6/stock-flyme-7.1.2.0G/scatter.txt shows 29 of 34
#   lines differing in OFFSET and none in name or position.
#   FACT: on M6, position 21 = boot is MEASURED on hardware (boot = mmcblk0p21,
#   factbase §5.1, unit REDACTED_UNIT).
#   INFERENCE: M6T therefore has boot = p21, system = p28, cache = p29,
#   userdata = p30. Strong, but INFERENCE - one `ls -l /dev/block/platform/
#   mtk-msdc.0/*/by-name/` on a real M6T settles it.
#
#   DO NOT COPY m681's fstab here. m681 is p22/p29/p30/p31; M6 and M6T are
#   p21/p28/p29/p30. Getting this wrong mounts `keystore` as /system.
#
# WHY RAW NODES AND NOT by-name
#   The stock M6T ramdisk uses by-name paths and the 3.18 kernel provides them.
#   The by-name form is kept commented below. Raw nodes are the default because
#   this tree is a placeholder for a future 4.19 kernel whose by-name behaviour
#   is unknown, and because the neighbouring m681 4.4 has no by-name links at all
#   (factbase:69).
#
# A13 first-stage init: entries flagged `first_stage_mount` are mounted before
# switch_root; /system must be one of them (system/core/init/first_stage_mount.cpp:505-525).
#
# <src>                    <mnt_point>  <type>  <mnt_flags and options>                                           <fs_mgr_flags>

# FIRST-STAGE ENTRIES ARE by-name, NOT RAW - and this is not taste (2026-09-25).
#   First-stage init waits for every first_stage_mount device by comparing
#   basename(<src>) with the PARTNAME of the block uevent
#   (system/core/init/block_dev_initializer.cpp, HandleUevent). "mmcblk0p28"
#   never equals "system", the wait times out after 10 s and init reboots into
#   the bootloader. FACT, measured on m95 on 2026-09-04 (kernel commit c507946d
#   in meizu_mx6_m95/kernel/m685, which is why m95 carries this table in its
#   DT). Neither the prebuilt nor the stock M6T DTB has a firmware/android node
#   (dtc), so first stage reads THIS file from the ramdisk; the stock ramdisk
#   itself uses these by-name paths (above). The raw-node line that stood here
#   until 2026-09-24 would have rebooted to the bootloader on every boot.
#   Second stage (mount_all) keeps the raw nodes below, as m95 does.
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/system   /system   ext4    ro,barrier=1    wait,first_stage_mount

# /vendor = the `custom` partition, p3, ~1 GiB (factory scatter; INFERENCE for
# the number p3, see BoardConfig.mk). Treble: TARGET_COPY_OUT_VENDOR := vendor,
# this is where vendor.img is flashed. Stock mounted the same partition as
# /custom (ro); that line is gone.
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/custom   /vendor   ext4    ro,barrier=1    wait,first_stage_mount

/dev/block/mmcblk0p30      /data        ext4    noatime,nosuid,nodev,noauto_da_alloc,discard                      wait,check,formattable
# /cache is nofail (lesson from the m95 bring-up, 2026-09-24).  `formattable`
# only covers a WIPED partition (fs_mgr.cpp:1496-1498: format and retry only
# when the partition has no filesystem).  A /cache that has one but still fails
# to mount counts as an error, and one error makes mount_all return
# FS_MGR_MNTALL_FAIL (system/core/fs_mgr/fs_mgr.cpp:1567, 1580, branch
# meizu-legacy-kernel); queue_fs_event() has no branch for that code
# (init/builtins.cpp:577-626, "Invalid code"), so ro.crypto.state is never set
# and zygote-start never fires.  With nofail the same failure is only logged
# ("Ignoring failure to mount an un-encryptable or wiped partition",
# fs_mgr.cpp:1557).
/dev/block/mmcblk0p29      /cache       ext4    noatime,nosuid,nodev,noauto_da_alloc,discard                      wait,check,formattable,nofail

# MediaTek platform partitions, names and positions from the factory scatter.
# /protect_f, /protect_s and /nvdata are nofail (lesson 11 of the m95 bring-up,
# 2026-09-24; m95's own fstab carries the same flags).  Without nofail a failed
# mount of any of them means a boot loop with no logs: one error makes
# mount_all return FS_MGR_MNTALL_FAIL (system/core/fs_mgr/fs_mgr.cpp:1567,
# 1580, branch meizu-legacy-kernel), init sets no ro.crypto.state and zygote
# never starts.  With nofail the phone boots, and the log shows that NVRAM or
# the IMEI is missing ("Ignoring failure to mount", fs_mgr.cpp:1557) instead
# of hiding it.  `formattable` does not cover this case: it only formats a
# partition that has no filesystem at all (fs_mgr.cpp:1496-1498).
/dev/block/mmcblk0p10      /protect_f   ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc          wait,check,formattable,nofail
/dev/block/mmcblk0p11      /protect_s   ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc          wait,check,formattable,nofail
/dev/block/mmcblk0p6       /nvdata      ext4    noatime,nosuid,nodev,noauto_da_alloc,discard                      wait,check,formattable,nofail

/dev/block/mmcblk0p18      /nvram       emmc    defaults                                                          defaults
/dev/block/mmcblk0p7       /proinfo     emmc    defaults                                                          defaults
/dev/block/mmcblk0p5       /persistent  emmc    defaults                                                          defaults
/dev/block/mmcblk0p19      /bootloader  emmc    defaults                                                          defaults
/dev/block/mmcblk0p20      /bootloader2 emmc    defaults                                                          defaults
/dev/block/mmcblk0p2       /misc        emmc    defaults                                                          defaults
/dev/block/mmcblk0p21      /boot        emmc    defaults                                                          defaults
/dev/block/mmcblk0p1       /recovery    emmc    defaults                                                          defaults
/dev/block/mmcblk0p22      /logo        emmc    defaults                                                          defaults
/dev/block/mmcblk0p4       /expdb       emmc    defaults                                                          defaults
/dev/block/mmcblk0p12      /seccfg      emmc    defaults                                                          defaults
/dev/block/mmcblk0p14      /md1img      emmc    defaults                                                          defaults
/dev/block/mmcblk0p15      /md1dsp      emmc    defaults                                                          defaults
/dev/block/mmcblk0p16      /md1arm7     emmc    defaults                                                          defaults
/dev/block/mmcblk0p17      /md3img      emmc    defaults                                                          defaults
/dev/block/mmcblk0p23      /tee1        emmc    defaults                                                          defaults
/dev/block/mmcblk0p24      /tee2        emmc    defaults                                                          defaults
/dev/block/mmcblk0p25      /secro       emmc    defaults                                                          defaults

# Removable storage
/devices/mtk-msdc.0/11240000.msdc1*     auto    auto    defaults    voldmanaged=sdcard1:auto
/devices/soc/11270000.usb3_xhci*        auto    auto    defaults    voldmanaged=usbotg:auto

# zram, same reasoning as the rest of the family.
/dev/block/zram0           none         swap    defaults                                                          zramsize=805306368
